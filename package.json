    "agentguard": "node packages/cli/dist/index.js"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.x"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^3.0.0",
    "@types/node": "^26.0.0",
    "oxlint": "^1.0.0"
  }
}
