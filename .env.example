# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit real keys.

# Required for the real decision engine (`agentguard test --live`,
# `agentguard replay --live`, `agentguard doctor --live`).
TYPESAFE_API_KEY=

# Optional — only needed for LLM escalation (`--escalate`) and
# `agentguard autofix propose`. Without it, escalation warns and skips,
# and autofix propose fails with a clear error; nothing else needs it.
ANTHROPIC_API_KEY=
